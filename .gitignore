# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Compiled bot binary (generated by bun build --compile) ───────────────────
discord-bot/bot

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Bot message content (customize locally, copy from messages.example.ts) ───
discord-bot/src/messages.ts

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
out/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.idea/
*.tsbuildinfo
