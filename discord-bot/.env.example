# ── Discord ────────────────────────────────────────────────────────────────────
# Create your bot at https://discord.com/developers/applications
# Enable the "Bot" section, generate a token, and invite the bot to your server
# with the "applications.commands" and "bot" scopes.

DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Your Discord server (guild) ID — right-click your server icon → Copy Server ID.
# If set, slash commands are registered as guild-scoped and appear instantly.
# Leave unset for global commands (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=your_guild_id_here


# ── Minecraft server ───────────────────────────────────────────────────────────
# Internal Railway hostname of the minecraft service.
# Must match the exact service name you gave it in the Railway dashboard
# (Railway private networking: <service-name>.railway.internal).

MC_HOST=minecraft.railway.internal
MC_PORT=25565


# ── RCON ──────────────────────────────────────────────────────────────────────
# Required for /stop, /restart, /say, /cmd, and accurate /players.
# Enable RCON on the MC service by setting:
#   ENABLE_RCON=true
#   RCON_PORT=25575
#   RCON_PASSWORD=<same value as MC_RCON_PASSWORD below>

# Defaults to MC_HOST if left unset.
# MC_RCON_HOST=minecraft.railway.internal

MC_RCON_PORT=25575
MC_RCON_PASSWORD=your_rcon_password_here
